# CampusLingo M1 environment template. Copy to a secret-managed environment;
# never commit real passwords, keys, or tokens.

# HTTP server (TLS-terminated in front; set Secure cookies in production).
CAMPUSLINGO_BIND=127.0.0.1:18080
CAMPUSLINGO_COOKIE_SECURE=1
CAMPUSLINGO_ALLOWED_ORIGIN=https://campus.example
CAMPUSLINGO_ASSET_DIR=/var/lib/campuslingo/assets

# Runtime roles. Use distinct strong passwords and host TLS or a private socket.
CAMPUSLINGO_AUTH_DATABASE_URL=postgres://campuslingo_auth:REPLACE@127.0.0.1/campuslingo
CAMPUSLINGO_APP_DATABASE_URL=postgres://campuslingo_app:REPLACE@127.0.0.1/campuslingo
CAMPUSLINGO_GRADER_DATABASE_URL=postgres://campuslingo_grader:REPLACE@127.0.0.1/campuslingo

# Migration-only role; never give this URL to the running server.
CAMPUSLINGO_ADMIN_DATABASE_URL=postgres://campuslingo_owner:REPLACE@127.0.0.1/campuslingo

# 64 hex characters (32 bytes). Shared with the separate recovery worker.
CAMPUSLINGO_RECOVERY_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# Recovery delivery worker (separate process; HTTPS unless loopback).
CAMPUSLINGO_RECOVERY_DATABASE_URL=postgres://campuslingo_recovery:REPLACE@127.0.0.1/campuslingo
CAMPUSLINGO_RECOVERY_DELIVERY_URL=https://mail-relay.internal.example/recovery

# M2 helper worker only: an empty delegated cgroup-v2 parent with the memory
# controller enabled. Not a regular filesystem directory. Missing/unavailable
# delegation refuses PDF/crop helpers; there is no unconstrained fallback.
# See docs/m2-status.md and scripts/verify_m2_containment.sh.
# CAMPUSLINGO_HELPER_CGROUP_ROOT=/sys/fs/cgroup/.../campuslingo-ingestion.service
