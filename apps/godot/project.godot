; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CampusLingo v2 — Concept Fortress"
config/description="3D Competitive Learning Strategy Game connected to campuslingo-server"
run/main_scene="res://scenes/MainGame.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

RunGovernor="*res://scripts/core/run_governor.gd"
SectionRegistry="*res://scripts/core/section_registry.gd"
Dev="*res://scripts/core/dev_tools.gd"
Juice="*res://scripts/fx/juice.gd"

[display]

window/size/viewport_width=1360
window/size/viewport_height=840
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
